#gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 15px;
  margin-top: 30px;
}

#gallery-grid img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 12px;
  transition: transform 0.3s ease;
}

#gallery-grid img:hover {
  transform: scale(1.05);
}
.avatar {
  width: 150px;       /* 根据需要调整大小 */
  height: 150px;
  border-radius: 50%; /* 圆形的关键 */
  object-fit: cover;  /* 防止拉伸 */
  display: block;
  margin: 0 auto;     /* 居中 */
}
